#!/bin/bash
# jw - Julia Warm: fast Julia test runner and formatter via tmux
# Keeps warm Julia sessions to avoid repeated precompilation
#
# Usage:
#   jw start <path>              Start a Julia REPL tab for a package
#   jw run <path> [filter]       Run tests (optionally filtered by filename substring)
#   jw output <path|name>        Capture test output from the tab
#   jw kill <path|name>          Kill a tab
#   jw format [path]             Format Julia code (defaults to current directory)
#   jw list                      List active tabs
#   jw prune                     Kill tabs of deleted directories and finished REPLs
#
# A REPL exits on its own after JW_IDLE_MINUTES (default 120) without a jw command.

READY_SENTINEL="__JW_READY__"
DONE_SENTINEL="__JW_DONE__"
IDLE_MINUTES="${JW_IDLE_MINUTES:-120}"

# Julia code run at REPL startup: exit once no jw command has arrived for IDLE_MINUTES.
# jw run/format wrap their command in jw_busy() so a long test run is never cut off.
# SIGHUP (sent when tmux closes the window) is ignored so Julia exits on stdin EOF instead
# and runs its atexit hooks; otherwise TestEnv's temp project, which can hold an ~800 MB
# CondaPkg environment, is left behind in the temp directory.
IDLE_WATCHDOG="ccall(:signal, Ptr{Cvoid}, (Cint, Ptr{Cvoid}), 1, Ptr{Cvoid}(1)); const JW_LAST = Ref(time()); const JW_BUSY = Ref(false); function jw_busy(f); JW_BUSY[] = true; try; f(); finally; JW_BUSY[] = false; JW_LAST[] = time(); end; end; const JW_TIMER = Timer(_ -> (!JW_BUSY[] && time() - JW_LAST[] > $IDLE_MINUTES * 60 && exit()), 60; interval=60)"

# Session name scoped to the git repo (or hostname if not in a repo). The path hash keeps
# clones that share a basename (e.g. /tmp/a/repo and /tmp/b/repo) in separate sessions;
# tmux would turn "." into "_" anyway.
repo_root=$(git rev-parse --show-toplevel 2>/dev/null)
if [ -n "$repo_root" ]; then
    base=$(basename "$repo_root")
    SESSION="jw-${base//./_}-$(printf '%s' "$repo_root" | shasum | cut -c1-6)"
else
    SESSION="jw-$(hostname -s)"
fi

ensure_session() {
    if ! tmux has-session -t "=$SESSION" 2>/dev/null; then
        tmux new-session -d -s "$SESSION" -n _placeholder
    fi
}

# Resolve a path argument to an absolute package directory
resolve_pkg_dir() {
    local input="$1"
    if [ -d "$input" ]; then
        (cd "$input" && pwd)
    elif [ -d "packages/$input" ]; then
        (cd "packages/$input" && pwd)
    else
        echo ""
    fi
}

# Derive a tmux window name from a package directory
win_name() {
    local dir="$1"
    local name
    name=$(basename "$dir")
    # Strip .jl suffix (tmux treats . as pane separator)
    echo "${name%.jl}"
}

has_window() {
    tmux list-windows -t "=$SESSION" -F '#{window_name}' 2>/dev/null | grep -qx "$1"
}

# Start Julia in a new window and wait for the ready sentinel. The shell exits with
# Julia so the window (and, with its last window, the session) goes away; on a failed
# start it lingers briefly so the error can be read.
launch_julia() {
    local win="$1" julia_cmd="$2" timeout="$3"
    tmux send-keys -t "$SESSION:$win" \
        "$julia_cmd || sleep 120; exit" Enter

    for i in $(seq 1 "$timeout"); do
        output=$(tmux capture-pane -t "$SESSION:$win" -p -S - 2>/dev/null)
        if echo "$output" | grep -q "^${READY_SENTINEL}$"; then
            echo "Ready! (${i}s)"
            tmux kill-window -t "$SESSION:_placeholder" 2>/dev/null
            return 0
        fi
        if echo "$output" | grep -q "^ERROR:"; then
            echo "Julia failed to start:"
            echo "$output" | grep -A2 "ERROR:"
            tmux kill-window -t "$SESSION:$win" 2>/dev/null
            return 1
        fi
        sleep 1
    done
    echo "Timed out waiting for Julia to start."
    return 1
}

start_tab() {
    local dir="$1"
    local win=$(win_name "$dir")
    if [ ! -f "$dir/Project.toml" ]; then echo "No Project.toml in: $dir"; return 1; fi

    ensure_session
    if has_window "$win"; then return 0; fi

    tmux new-window -t "$SESSION" -n "$win" -c "$dir"
    echo "Starting Julia for $win... waiting for REPL."
    launch_julia "$win" \
        "julia --project=@. -e 'using Revise; using TestEnv; TestEnv.activate(); using TestItemRunner; $IDLE_WATCHDOG; println(\"$READY_SENTINEL\")' -i" 90
}

start_formatter() {
    ensure_session
    local win="formatter"
    if has_window "$win"; then return 0; fi

    tmux new-window -t "$SESSION" -n "$win"
    echo "Starting Julia with JuliaFormatter... waiting for REPL."
    launch_julia "$win" \
        "julia -e 'using JuliaFormatter; $IDLE_WATCHDOG; println(\"$READY_SENTINEL\")' -i" 120
}

case "${1:-help}" in
    start)
        input="$2"
        if [ -z "$input" ]; then echo "Usage: jw start <path>"; exit 1; fi
        dir=$(resolve_pkg_dir "$input")
        if [ -z "$dir" ]; then echo "Directory not found: $input"; exit 1; fi
        win=$(win_name "$dir")
        if has_window "$win"; then
            echo "Tab '$win' already exists. Use 'jw kill $win' first."
            exit 1
        fi
        start_tab "$dir" || exit 1
        ;;

    run)
        input="$2"
        filter="$3"
        if [ -z "$input" ]; then echo "Usage: jw run <path> [filter]"; exit 1; fi
        dir=$(resolve_pkg_dir "$input")
        if [ -z "$dir" ]; then echo "Directory not found: $input"; exit 1; fi
        win=$(win_name "$dir")

        if ! has_window "$win"; then
            echo "No tab for '$win'. Starting automatically..."
            start_tab "$dir" || exit 1
        fi

        if [ -z "$filter" ]; then
            cmd='include("test/runtests.jl")'
        else
            cmd="@run_package_tests filter=ti->contains(ti.filename, \"$filter\")"
        fi

        tmux send-keys -t "$SESSION:$win" C-l
        sleep 0.2
        tmux clear-history -t "$SESSION:$win"
        tmux send-keys -t "$SESSION:$win" "Revise.revise(); let errs=Revise.errors(); (errs === nothing || isempty(errs)) || println(\"WARNING: Revise errors — restart recommended: \", keys(errs)); end" Enter
        sleep 0.5
        tmux send-keys -t "$SESSION:$win" "jw_busy() do; try; $cmd; catch e; println(e); end; end; println(\"$DONE_SENTINEL\")" Enter
        echo "Tests running in $win..."

        for i in $(seq 1 300); do
            output=$(tmux capture-pane -t "$SESSION:$win" -p -S -5 2>/dev/null)
            # Match sentinel only at line start (not in the command echo which has a leading `>`)
            if echo "$output" | grep -q "^${DONE_SENTINEL}$"; then
                full=$(tmux capture-pane -t "$SESSION:$win" -p -S - 2>/dev/null)
                echo "$full" | grep -A1 "Test Summary\|tests passed\|Error\|ERROR"
                exit 0
            fi
            sleep 1
        done
        echo "Timed out waiting for tests (5min)."
        exit 1
        ;;

    output)
        input="$2"
        if [ -z "$input" ]; then echo "Usage: jw output <path|name>"; exit 1; fi
        dir=$(resolve_pkg_dir "$input")
        if [ -z "$dir" ]; then
            # Allow passing a window name directly (e.g. "formatter")
            win="$input"
        else
            win=$(win_name "$dir")
        fi
        tmux capture-pane -t "$SESSION:$win" -p -S -100
        ;;

    kill)
        name="$2"
        if [ -z "$name" ]; then echo "Usage: jw kill <path|name>"; exit 1; fi
        # Accept either a path or a window name directly
        dir=$(resolve_pkg_dir "$name")
        if [ -n "$dir" ]; then
            win=$(win_name "$dir")
        else
            win="${name%.jl}"
        fi
        tmux send-keys -t "$SESSION:$win" C-c
        sleep 0.5
        tmux send-keys -t "$SESSION:$win" 'exit()' Enter
        sleep 0.5
        tmux kill-window -t "$SESSION:$win" 2>/dev/null
        echo "Killed $win tab."
        ;;

    format)
        target="${2:-.}"
        target=$(cd "$target" 2>/dev/null && pwd)
        if [ -z "$target" ]; then echo "Directory not found: $2"; exit 1; fi

        win="formatter"
        if ! has_window "$win"; then
            echo "No formatter tab. Starting automatically..."
            start_formatter || exit 1
        fi

        tmux send-keys -t "$SESSION:$win" C-l
        sleep 0.2
        tmux clear-history -t "$SESSION:$win"
        tmux send-keys -t "$SESSION:$win" \
            "jw_busy(() -> format(\"$target\")); println(\"$DONE_SENTINEL\")" Enter
        echo "Formatting $target..."

        for i in $(seq 1 300); do
            output=$(tmux capture-pane -t "$SESSION:$win" -p -S -5 2>/dev/null)
            if echo "$output" | grep -q "^${DONE_SENTINEL}$"; then
                echo "Done! (${i}s)"
                exit 0
            fi
            sleep 1
        done
        echo "Timed out waiting for formatter (5min)."
        exit 1
        ;;

    list)
        if ! tmux has-session -t "=$SESSION" 2>/dev/null; then
            echo "No jw session running."
            exit 0
        fi
        tmux list-windows -t "=$SESSION" -F '#{window_name} (#{pane_current_command})'
        ;;

    prune)
        # Across all jw sessions: kill windows whose directory is gone or whose Julia has
        # exited (a bare shell left by older jw versions), plus leftover placeholders.
        n=0
        while IFS='|' read -r target cmd path; do
            if [ ! -d "$path" ] || [ "$cmd" != "julia" ]; then
                tmux kill-window -t "$target" 2>/dev/null && n=$((n + 1))
            fi
        done < <(tmux list-windows -a -F '#{session_name}:#{window_index}|#{pane_current_command}|#{pane_current_path}' 2>/dev/null | grep '^jw-')
        echo "Pruned $n tab(s)."
        ;;

    help|*)
        echo "jw - Julia Warm: fast test runner and formatter via tmux"
        echo ""
        echo "  jw start <path>             Start Julia REPL tab (with Revise + TestEnv)"
        echo "  jw run <path> [filter]      Run tests (filter by filename substring)"
        echo "  jw output <path|name>       Show recent output"
        echo "  jw kill <path|name>         Kill a tab"
        echo "  jw format [path]            Format Julia code (default: current dir)"
        echo "  jw list                     List active tabs"
        echo "  jw prune                    Kill tabs of deleted dirs and finished REPLs"
        echo ""
        echo "  <path> can be a relative/absolute dir or a name under packages/"
        echo "  REPLs exit after \$JW_IDLE_MINUTES (default 120) without a jw command."
        ;;
esac
